 "decide": [
  {
   "name": "the server's value is older: the offline position wins",
   "update": {
    "itemId": "a1",
    "userId": "u1",
    "at": "2026-10-16T11:00:00.000Z",
    "userData": {
     "PlaybackPositionTicks": 600,
     "LastPlayedDate": "2026-10-16T11:00:00.000Z"
    }
   },
   "server": {
    "Id": "a1",
    "UserData": {
     "LastPlayedDate": "2026-10-16T09:00:00.0000000Z",
     "PlaybackPositionTicks": 50,
     "Played": false
    }
   },
   "expected": {
    "userData": {
     "PlaybackPositionTicks": 600,
     "LastPlayedDate": "2026-10-16T11:00:00.000Z"
    }
   }
  },
  {
   "name": "a newer position set elsewhere stays",
   "update": {
    "itemId": "a1",
    "userId": "u1",
    "at": "2026-10-16T11:00:00.000Z",
    "userData": {
     "PlaybackPositionTicks": 600,
