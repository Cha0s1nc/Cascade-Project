{
 "about": "Shared by test/offline-sync.test.ts and CascadeKit's OfflineSyncTests: the same queued changes, server answers and expected results.",
 "coalesce": [
  {
   "name": "only the last position matters",
   "changes": [
    {
     "itemId": "a1",
     "userId": "u1",
     "at": "2026-10-16T10:00:00.000Z",
     "kind": "position",
     "ticks": 100
    },
    {
     "itemId": "a1",
     "userId": "u1",
     "at": "2026-10-16T11:00:00.000Z",
     "kind": "position",
     "ticks": 200
    }
   ],
   "expected": [
    {
     "itemId": "a1",
     "userId": "u1",
     "at": "2026-10-16T11:00:00.000Z",
     "userData": {
      "PlaybackPositionTicks": 200,
      "LastPlayedDate": "2026-10-16T11:00:00.000Z"
     }
    }
   ]
  },
  {
   "name": "a favorite toggled twice is no change",
   "changes": [
    {
     "itemId": "a1",
     "userId": "u1",
     "at": "2026-10-16T10:00:00.000Z",
     "kind": "favorite",
     "favorite": true,
     "was": false
    },
    {
     "itemId": "a1",
     "userId": "u1",
     "at": "2026-10-16T11:00:00.000Z",
     "kind": "favorite",
     "favorite": false,
     "was": true
    }
   ],
   "expected": []
  },
  {
   "name": "a favorite once",
   "changes": [
    {
     "itemId": "a1",
     "userId": "u1",
     "at": "2026-10-16T10:00:00.000Z",
     "kind": "favorite",
     "favorite": true,
     "was": false
    }
   ],
   "expected": [
    {
     "itemId": "a1",
     "userId": "u1",
     "at": "2026-10-16T10:00:00.000Z",
     "favorite": true
    }
   ]
  },
