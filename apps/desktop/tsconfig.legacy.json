{
  // Type-checking for the legacy plain-JS files (renderer.js, waterfall.js,
  // main.js). Separate from tsconfig.json because TypeScript has no per-file
  // strictness: src/ is checked strictly, this is checked loosely.
  //
  // The goal here is catching typos, wrong argument counts and misspelled
  // properties - NOT null-safety. renderer.js has 374 getElementById calls;
  // demanding a null check on each would bury every real finding.
  //
  // Opt-in: `npm run typecheck:legacy`. Deliberately NOT part of the umbrella
  // `npm run typecheck`, which has to stay green to be worth running.
  //
  // This pass currently reports ~184 findings, almost all of them the same
  // shape: getElementById returns HTMLElement, so .value and .checked are not
  // on the type. They are pre-existing and none of them are bugs. Wiring this
  // into the gate would mean a check that always fails, which is a check nobody
  // reads. Worth chipping at; not worth blocking on.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    // Deliberately loose - see above.
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,

    "types": []
  },
  "include": ["renderer.js", "waterfall.js", "main.js", "../../packages/core/types/**/*.d.ts"]
}
