<Project Sdk="Microsoft.NET.Sdk">

  <!-- Jellyfin 12 only (.NET 10), since 1.1.0. 1.0.0 was also built for 10.11
       (1.0.0.10), and that build stays in the catalog for 10.11 servers.

       The version's last part says which Jellyfin a build is for: 1.1.0.12 is the
       Jellyfin 12 build of release 1.1.0. Jellyfin offers a server every version
       whose targetAbi is at or below its own and installs the highest. -->
  <PropertyGroup>
    <!-- The release number. A release tag must match it: server-v1.1.0 for 1.1.0
         (.github/workflows/server.yml). -->
    <PluginVersion>1.1.0</PluginVersion>
  </PropertyGroup>

  <!-- Built against 12.0, not 12.1, so it also loads on 12.0 servers. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinPackageVersion>12.0.0</JellyfinPackageVersion>
    <LoggingPackageVersion>10.0.11</LoggingPackageVersion>
    <JellyfinVersionPart>12</JellyfinVersionPart>
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.CascadeServer</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.CascadeServer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>$(PluginVersion).$(JellyfinVersionPart)</Version>
    <AssemblyVersion>$(PluginVersion).$(JellyfinVersionPart)</AssemblyVersion>
    <FileVersion>$(PluginVersion).$(JellyfinVersionPart)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference Jellyfin's controller package - PrivateAssets=All means it won't be
         copied into the plugin zip; Jellyfin provides these at runtime. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(LoggingPackageVersion)" PrivateAssets="All" />
    <!-- Jellyfin ships TagLibSharp 2.3.0, so it is not copied into the zip. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" PrivateAssets="All" ExcludeAssets="runtime" />
    <!-- Jellyfin ships SkiaSharp too (3.119.4 on 12), for decoding animated WebP
         covers, which its ffmpeg cannot. The exact server version, and never copied into the zip. -->
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" PrivateAssets="All" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dashboard page for the "Cascade Server" sidebar tab (lyrics status report). -->
    <EmbeddedResource Include="Web\status.html" />
    <EmbeddedResource Include="Web\cascadeserver.css" />
    <EmbeddedResource Include="Web\cascadeserver.js" />
  </ItemGroup>

</Project>
