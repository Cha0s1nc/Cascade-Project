<?xml version="1.0" encoding="UTF-8"?>
<!-- The app's listing for Flathub and software centers. package.sh adds each
     version's <release> line to the copy in the tarball; before submitting,
     see FLATHUB.md (screenshots are still missing). -->
<component type="desktop-application">
  <id>xyz.chaosinc.cascade</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only AND LicenseRef-proprietary=https://github.com/Cha0s1nc/Cascade-Project/blob/stable/shared/assets/LICENSE</project_license>
  <name>Cascade</name>
  <summary>Music and video for your Jellyfin server</summary>
  <developer id="xyz.chaosinc">
    <name>cha0s_1nc</name>
  </developer>
  <description>
    <p>Cascade plays the music, movies and TV shows on your own Jellyfin server, with synced lyrics, crossfade and an equalizer built in.</p>
    <ul>
      <li>Synced lyrics, word by word where the song has them</li>
      <li>Crossfade, normalization and an equalizer</li>
      <li>Downloads for listening offline</li>
      <li>Movies and TV with subtitles and audio track choice</li>
      <li>Media keys, the desktop's media controls and Discord status</li>
    </ul>
  </description>
  <launchable type="desktop-id">xyz.chaosinc.cascade.desktop</launchable>
  <url type="homepage">https://cascade.chaosinc.xyz</url>
  <url type="bugtracker">https://github.com/Cha0s1nc/Cascade-Project/issues</url>
  <url type="vcs-browser">https://github.com/Cha0s1nc/Cascade-Project</url>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <branding>
    <color type="primary" scheme_preference="light">#9fc4ff</color>
    <color type="primary" scheme_preference="dark">#0b1a33</color>
  </branding>
  <!-- Empty on purpose: package.sh adds the version being built. The Flathub
       listing starts at 3.0.0 and 2.x stays off it; once 3.0.0 is out, add
       each published version here, newest first, so the listing keeps its
       history. -->
  <releases>
  </releases>
</component>
