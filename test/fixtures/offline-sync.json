    "itemId": "a1",
    "userId": "u1",
    "at": "2026-10-16T11:00:00.000Z",
    "favorite": true,
    "userData": {
     "PlaybackPositionTicks": 0,
     "Played": true,
     "LastPlayedDate": "2026-10-16T11:00:00.000Z"
    }
   },
   "server": {
    "Id": "a1",
    "UserData": {
     "LastPlayedDate": "2026-10-16T08:00:00.0000000Z",
     "Played": true,
     "PlaybackPositionTicks": 0,
     "IsFavorite": false
    }
   },
   "expected": {
    "favorite": true
   }
  },
  {
   "name": "nothing left to send",
