{
  "name": "cascade",
  "version": "2.0.2",
  "description": "A Jellyfin music client inspired by Cider",
  "main": "main.js",
  "scripts": {
    "build:core": "esbuild src/index.ts --bundle --format=iife --global-name=CascadeCore --outfile=build/core.js --target=chrome122 --sourcemap",
    "build:preload": "esbuild src/preload.ts --bundle --format=cjs --platform=node --external:electron --outfile=build/preload.js --target=node20 --sourcemap",
    "build:ts": "npm run build:core && npm run build:preload && npm run build:worker && npm run build:bergamot && npm run models",
    "typecheck": "tsc --noEmit",
    "typecheck:legacy": "tsc -p tsconfig.legacy.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "npm run build:ts && electron .",
    "dev": "npm run build:ts && electron . --inspect",
    "dev:second": "npm run build:ts && electron . --user-data-dir=/tmp/cascade-second-instance",
    "build": "npm run build:ts && electron-builder",
    "build:mac": "npm run build:ts && electron-builder --mac --publish never",
    "build:win": "npm run build:ts && electron-builder --win --publish never",
    "build:linux": "npm run build:ts && electron-builder --linux --publish never",
    "icons": "node scripts/gen-icons.js",
    "models": "node scripts/fetch-models.js",
    "build:bergamot": "node scripts/build-bergamot.js",
    "build:worker": "esbuild src/translate-worker.ts --bundle --format=iife --outfile=build/translate-worker.js --target=chrome122 --sourcemap"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@browsermt/bergamot-translator": "0.4.9",
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^26.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "franc-min": "^6.2.0",
    "sharp": "^0.33.4",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "cha0s_1nc",
    "email": "contact@chaosinc.xyz"
  },
  "license": "SEE LICENSE IN LICENSE",
  "allowScripts": {
    "electron@44.3.0": true,
    "sharp@0.33.5": true
  },
  "build": {
    "appId": "xyz.chaosinc.cascade",
    "productName": "Cascade",
    "copyright": "Copyright © 2026 cha0s",
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "waterfall.js",
      "build/core.js",
      "build/preload.js",
      "build/translate-worker.js",
      "build/bergamot/**/*",
      "updater.html",
      "updater-preload.js",
      "lyrics-editor.html",
      "lyrics-editor-preload.js",
      "metadata-editor.html",
      "metadata-editor-preload.js",
      "miniplayer.html",
      "miniplayer-preload.js",
      "package.json",
      "translation-models.json",
      "LICENSE",
      "assets/LICENSE",
      "node_modules/**/*",
      "!node_modules/@img/**"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Audio",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Cascade${arch}",
      "backgroundColor": "#111113"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "assets/installer-sidebar.bmp",
      "installerHeader": "assets/installer-header.bmp",
      "license": "assets/installer-license.txt",
      "shortcutName": "Cascade",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
