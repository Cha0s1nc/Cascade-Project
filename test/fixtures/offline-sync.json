   "server": {
    "Id": "a1",
    "UserData": {
     "LastPlayedDate": "2026-10-16T12:00:00.0000000Z",
     "PlaybackPositionTicks": 900
    }
   },
   "expected": null
  },
  {
   "name": "the same time is not older",
   "update": {
    "itemId": "a1",
    "userId": "u1",
    "at": "2026-10-16T11:00:00.000Z",
    "userData": {
     "PlaybackPositionTicks": 600,
     "LastPlayedDate": "2026-10-16T11:00:00.000Z"
    }
   },
   "server": {
    "Id": "a1",
    "UserData": {
     "LastPlayedDate": "2026-10-16T11:00:00.0000000Z"
    }
   },
   "expected": null
  },
  {
   "name": "never played on the server",
   "update": {
    "itemId": "a1",
    "userId": "u1",
    "at": "2026-10-16T11:00:00.000Z",
    "userData": {
     "PlaybackPositionTicks": 600,
     "LastPlayedDate": "2026-10-16T11:00:00.000Z"
    }
   },
   "server": {
    "Id": "a1",
    "UserData": {
     "Played": false
    }
   },
   "expected": {
    "userData": {
     "PlaybackPositionTicks": 600,
     "LastPlayedDate": "2026-10-16T11:00:00.000Z"
    }
   }
  },
  {
   "name": "the server no longer has the item",
   "update": {
    "itemId": "a1",
    "userId": "u1",
    "at": "2026-10-16T11:00:00.000Z",
    "userData": {
     "PlaybackPositionTicks": 600,
     "LastPlayedDate": "2026-10-16T11:00:00.000Z"
    }
   },
   "server": null,
   "expected": null
  },
  {
   "name": "what the server already holds is left out",
