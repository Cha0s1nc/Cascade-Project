<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the pure parts only. The source files are compiled in directly, so the
       tests need no Jellyfin packages: keep Jellyfin types out of anything listed here. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Jellyfin.Plugin.CascadeServer\Style\StylePreset.cs" Link="Pure\StylePreset.cs" />
  </ItemGroup>

</Project>
