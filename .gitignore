node_modules/
.DS_Store
*.log
dist/
out/
.cascade-debug

# Agent worktrees only. .claude/agents/ IS tracked - those definitions are
# part of the project, and ignoring all of .claude/ would silently stop them
# from being updated.
.claude/worktrees/

# esbuild output (src/ -> build/core.js). Rebuilt by `npm run build:ts`, which
# every start/build script runs first, so it never needs to be committed.
build/
*.slrc
spicylyrics-integration.js
lyrics_align_test.py

# Cloudflare Worker (signaling/) local state - wrangler's
# cache/dev-session data and any local secrets, never the source or lockfile.
signaling/.wrangler/
signaling/.dev.vars
# Translation models + ONNX runtime, fetched by scripts/fetch-models.js at
# build time. 228 MB has no business in git.
models/
