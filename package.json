{
  "name": "cascade",
  "version": "1.2.0",
  "description": "A Jellyfin music client inspired by Cider",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test -w @cascade/core",
    "typecheck": "npm run typecheck -w @cascade/core",
    "desktop": "npm start -w @cascade/desktop",
    "build:ts": "npm run build:ts -w @cascade/desktop",
    "typecheck:legacy": "npm run typecheck:legacy -w @cascade/desktop",
    "tv:ios": "npm run ios -w @cascade/tv",
    "tv:android": "npm run android -w @cascade/tv",
    "typecheck:tv": "npm run typecheck -w @cascade/tv",
    "test:tv": "npm test -w @cascade/tv"
  },
  "author": {
    "name": "cha0s_1nc",
    "email": "contact@chaosinc.xyz"
  },
  "license": "GPL-3.0"
}
